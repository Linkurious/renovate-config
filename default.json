{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>Linkurious/renovate-config:meta",
    "customManagers:dockerfileVersions",
    "customManagers:helmChartYamlAppVersions",
    "security:minimumReleaseAgeNpm"
  ],
  "baseBranchPatterns": [
    "develop-maintenance",
    "develop-stable",
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "branchConcurrentLimit": 10,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 10,
  "respectLatest": true,
  "ignoreUnstable": true,
  "schedule": "every weekend",
  "customDatasources": {
    "debian-trixie": {
      "description": "Debian trixie main and security archives via Debian QA madison, because the deb datasource cannot read security.debian.org (Packages.xz only)",
      "defaultRegistryUrlTemplate": "https://qa.debian.org/madison.php?package={{packageName}}&table=debian,debian-security&s=trixie,trixie-security&a=amd64,all&text=on",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases[$contains(version, "|")].{\"version\": $trim($split(version, "|")[1])}]}"
      ]
    }
  },
  "packageRules": [
    {
      "matchDatasources": ["deb"],
      "registryUrls": [
        "https://deb.debian.org/debian?suite=stable&components=main,contrib,non-free&binaryArch=amd64"
      ]
    },
    {
      "internalChecksFilter": "strict",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["@linkurious/**"],
      "minimumReleaseAge": null
    },
    {
      "matchDatasources": ["docker", "node-version", "npm"],
      "matchPackageNames": ["/(?:^|/)node$/"],
      "groupName": "node and docker node updates",
      "groupSlug": "node-docker-updates"
    },
    {
      "matchDatasources": [
        "npm",
        "node-version"
      ],
      "addLabels": [
        "javascript"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchBaseBranches": [
        "develop-maintenance",
        "develop-stable"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "additionalBranchPrefix": "{{packageFileDir}}-",
      "commitMessageSuffix": "{{packageFileDir}}-",
      "bumpVersion": "patch",
      "matchPackageNames": [
        "/.*/"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "addLabels": [
      "type:security"
    ]
  },
  "npmrc": "@linkurious:registry=https://nexus3.linkurious.net/repository/npm/",
  "hostRules": [
    {
      "hostType": "npm",
      "matchHost": "https://nexus3.linkurious.net/repository/npm/",
      "token": "{{ secrets.mend_nexus_ro }}",
      "authType": "Basic"
    },
    {
      "hostType": "helm",
      "matchHost": "https://nexus3.linkurious.net/repository/helm-linkurious",
      "token": "{{ secrets.mend_nexus_ro }}",
      "authType": "Basic"
    },
    {
      "matchHost": "https://hub.docker.nexus3.linkurious.net",
      "token": "{{ secrets.mend_nexus_ro }}",
      "authType": "Basic"
    },
    {
      "matchHost": "https://public-pull.nexus3.linkurious.net",
      "token": "{{ secrets.mend_nexus_public_pull }}",
      "authType": "Basic"
    }
  ]
}
