{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>Linkurious/renovate-config:meta",
    "workarounds:nodeDockerVersioning",
    "customManagers:dockerfileVersions"
  ],
  "baseBranchPatterns": [
    "develop-maintenance",
    "develop-stable",
    "develop"
  ],
  "labels": [
    "dependencies"
  ],
  "branchConcurrentLimit": 10,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 10,
  "respectLatest": true,
  "ignoreUnstable": true,
  "schedule": "every weekend",
  "packageRules": [
    {
      "matchDatasources": ["docker", "node-version"],
      "matchPackagePatterns": ["node"],
      "groupName": "node and docker node updates",
      "groupSlug": "node-docker-updates"
    },
    {
      "matchDatasources": [
        "npm",
        "node-version"
      ],
      "addLabels": [
        "javascript"
      ]
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "matchBaseBranches": [
        "develop-maintenance",
        "develop-stable"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "helmv3"
      ],
      "additionalBranchPrefix": "{{packageFileDir}}-",
      "commitMessageSuffix": "{{packageFileDir}}-",
      "bumpVersion": "patch",
      "matchPackageNames": [
        "/.*/"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "addLabels": [
      "type:security"
    ]
  },
  "npmrc": "@linkurious:registry=https://nexus3.linkurious.net/repository/npm/",
  "hostRules": [
    {
      "hostType": "npm",
      "matchHost": "https://nexus3.linkurious.net/repository/npm/",
      "token": "{{ secrets.mend_nexus_ro }}",
      "authType": "Basic"
    },
    {
      "hostType": "helm",
      "matchHost": "https://nexus3.linkurious.net/repository/helm-linkurious",
      "token": "{{ secrets.mend_nexus_ro }}",
      "authType": "Basic"
    },
    {
      "matchHost": "https://hub.docker.nexus3.linkurious.net",
      "token": "{{ secrets.mend_nexus_ro }}",
      "authType": "Basic"
    }
  ]
}
